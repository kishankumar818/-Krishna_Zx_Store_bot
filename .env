# ═══════════════════════════════════════════════════════════
# KRISHNA_ZX_STORE — Environment Config
# Yeh file SIRF server pe rahegi, kabhi GitHub pe push na karo
# ═══════════════════════════════════════════════════════════

# ─── Telegram Bot (BotFather se naya token lo) ───
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ADMIN_ID=8917638509
BOT_USERNAME=@Krishna_Zx_Store_bot

# ─── Store Branding ───
STORE_NAME=Krishna_Zx_Store
CURRENCY=INR

# ─── UPI Payment (Apna UPI ID daalo) ───
UPI_ID=yourname@fam

# ─── Email Verification (Gmail App Password) ───
# Gmail: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
IMAP_HOST=imap.gmail.com

# ─── Payment Senders (Bank/FamPay domains) ───
PAYMENT_SENDERS=fampay,npci,yesbank,axisbank,icicibank,hdfcbank,sbi

# ─── Security ───
REQUIRE_DKIM=true

# ─── Timing ───
MAIL_LOOKBACK_DAYS=2
EMAIL_POLL_SECONDS=30
EMAIL_POLL_ROUNDS=20

# ─── Auto Approve ───
AUTO_APPROVE=true

# ─── Database ───
DB_PATH=krishna_zx_store.db
